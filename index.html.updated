<!DOCTYPE html>
<html lang="si">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bin Card Admin Panel</title>
    <link rel="icon" type="image/png" href="data:image/png;base64,">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Firebase SDKs -->
    <script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.22.2/firebase-firestore-compat.js"></script>
    <!-- SheetJS (XLSX Reader) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <!-- QRCode.js -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- jsPDF + AutoTable for Registered Items PDF -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.4/jspdf.plugin.autotable.min.js"></script>
    <!-- JSZip for Bin Card ZIP export -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <style>
        :root { --fire-red:#dc2626; --fire-orange:#f97316; --fire-yellow:#facc15; --fire-dark:#09090b; }
        html { scroll-behavior:smooth; }
        body { background:radial-gradient(circle at 50% -10%,rgba(249,115,22,.16),transparent 34%),radial-gradient(circle at 10% 20%,rgba(220,38,38,.10),transparent 28%),#09090b !important; color:#f4f4f5 !important; }
        .app-header { background:linear-gradient(135deg,#050505 0%,#18181b 55%,#450a0a 100%); border-bottom:1px solid rgba(249,115,22,.35); box-shadow:0 10px 30px rgba(0,0,0,.45); }
        .app-logo { width:58px;height:58px;object-fit:cover;border-radius:16px;border:2px solid #f97316;box-shadow:0 0 0 3px rgba(220,38,38,.22),0 0 24px rgba(249,115,22,.28);background:#000; }
        .brand-title { background:linear-gradient(90deg,#fff7ed,#fbbf24,#fb923c,#ef4444);-webkit-background-clip:text;background-clip:text;color:transparent; }
        .fire-panel { background:linear-gradient(145deg,rgba(24,24,27,.97),rgba(9,9,11,.97));border:1px solid rgba(249,115,22,.22);box-shadow:0 14px 35px rgba(0,0,0,.35); }
        .fire-panel:hover { border-color:rgba(249,115,22,.42); }
        .fire-input-card { background:linear-gradient(145deg,rgba(24,24,27,.96),rgba(39,39,42,.92));border:1px solid rgba(255,255,255,.07); }
        .drop-zone { border:2px dashed rgba(249,115,22,.65);background:rgba(39,39,42,.55) !important;transition:all .3s ease; }
        .drop-zone:hover,.drop-zone.dragover { background:rgba(127,29,29,.22) !important;border-color:#facc15;transform:translateY(-2px);box-shadow:0 10px 28px rgba(249,115,22,.12); }
        .registered-section { overflow:hidden;max-height:0;opacity:0;transform:translateY(-8px);transition:max-height .45s ease,opacity .25s ease,transform .35s ease,margin-top .35s ease;margin-top:0; }
        .registered-section.is-open { max-height:50000px;opacity:1;transform:translateY(0);margin-top:18px; }\n        #items-table-body tr, #items-card-container > div { content-visibility:auto; contain-intrinsic-size:90px; }
        .details-toggle { background:linear-gradient(135deg,#991b1b,#ea580c 55%,#f59e0b);border:1px solid rgba(254,215,170,.35);box-shadow:0 8px 22px rgba(234,88,12,.22); }
        .details-toggle:hover { filter:brightness(1.08);transform:translateY(-1px); }
        .fire-button { background:linear-gradient(135deg,#b91c1c,#ea580c);border:1px solid rgba(251,146,60,.35); }
        .fire-button:hover { background:linear-gradient(135deg,#dc2626,#f97316); }
        .fire-table-head { background:linear-gradient(90deg,#18181b,#7f1d1d,#18181b); }
        .section-glow { height:2px;width:100%;background:linear-gradient(90deg,transparent,#ef4444,#facc15,#f97316,transparent); }
        @media (max-width:640px){.app-logo{width:48px;height:48px;border-radius:13px;}}

        /* =========================================================
           Professional 4-second intro / loading screen
           ========================================================= */
        body.splash-active { overflow:hidden !important; }
        .intro-overlay {
            position:fixed;
            inset:0;
            z-index:99999;
            display:flex;
            align-items:center;
            justify-content:center;
            overflow:hidden;
            background:
                radial-gradient(circle at 50% 38%, rgba(249,115,22,.13), transparent 28%),
                radial-gradient(circle at 50% 55%, rgba(220,38,38,.11), transparent 38%),
                #010102;
            color:#fff;
            isolation:isolate;
            opacity:1;
            visibility:visible;
            transition:opacity .65s ease, visibility .65s ease;
        }
        .intro-overlay::before {
            content:"";
            position:absolute;
            inset:0;
            z-index:-2;
            background-image:
                linear-gradient(rgba(255,255,255,.025) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.025) 1px, transparent 1px);
            background-size:44px 44px;
            mask-image:linear-gradient(to bottom, transparent, #000 18%, #000 82%, transparent);
        }
        .intro-overlay::after {
            content:"";
            position:absolute;
            width:min(70vw,700px);
            height:min(70vw,700px);
            border-radius:50%;
            border:1px solid rgba(249,115,22,.10);
            box-shadow:0 0 90px rgba(220,38,38,.08), inset 0 0 80px rgba(249,115,22,.04);
            animation:introPulse 2.1s ease-in-out infinite;
            z-index:-1;
        }
        .intro-overlay.is-hidden {
            opacity:0;
            visibility:hidden;
            pointer-events:none;
        }
        .intro-shell {
            width:min(92vw,700px);
            text-align:center;
            padding:28px 22px 24px;
            position:relative;
        }
        .intro-logo-wrap {
            position:relative;
            width:clamp(130px,30vw,190px);
            height:clamp(130px,30vw,190px);
            margin:0 auto 18px;
            display:grid;
            place-items:center;
        }
        .intro-logo-wrap::before,
        .intro-logo-wrap::after {
            content:"";
            position:absolute;
            inset:-12px;
            border-radius:50%;
            border:1px solid rgba(249,115,22,.35);
            animation:spinRing 3.2s linear infinite;
        }
        .intro-logo-wrap::after {
            inset:-23px;
            border-color:rgba(220,38,38,.18);
            border-left-color:#facc15;
            border-right-color:#ef4444;
            animation:spinRingReverse 4.4s linear infinite;
        }
        .intro-logo {
            width:100%;
            height:100%;
            object-fit:contain;
            filter:drop-shadow(0 0 16px rgba(249,115,22,.38)) drop-shadow(0 0 34px rgba(220,38,38,.22));
            animation:logoFloat 1.8s ease-in-out infinite;
        }
        .intro-kicker {
            display:inline-flex;
            align-items:center;
            gap:7px;
            padding:6px 12px;
            border-radius:999px;
            border:1px solid rgba(251,191,36,.25);
            background:rgba(255,255,255,.035);
            color:#fed7aa;
            font-size:11px;
            letter-spacing:.16em;
            text-transform:uppercase;
            font-weight:800;
            margin-bottom:10px;
        }
        .intro-title {
            margin:0;
            font-size:clamp(27px,6vw,48px);
            line-height:1.04;
            font-weight:950;
            letter-spacing:-.035em;
            background:linear-gradient(90deg,#fff,#fef3c7 28%,#facc15 52%,#fb923c 74%,#ef4444);
            -webkit-background-clip:text;
            background-clip:text;
            color:transparent;
            text-shadow:0 0 28px rgba(249,115,22,.08);
        }
        .intro-subtitle {
            margin:10px auto 0;
            max-width:590px;
            color:#d4d4d8;
            font-size:clamp(13px,2.4vw,16px);
            line-height:1.65;
        }
        .intro-features {
            display:flex;
            flex-wrap:wrap;
            justify-content:center;
            gap:8px;
            margin:18px auto 18px;
        }
        .intro-feature {
            display:inline-flex;
            align-items:center;
            gap:7px;
            padding:7px 10px;
            border-radius:10px;
            background:rgba(255,255,255,.035);
            border:1px solid rgba(255,255,255,.08);
            color:#e4e4e7;
            font-size:11px;
        }
        .intro-feature i { color:#fb923c; }
        .intro-loader {
            width:min(100%,430px);
            margin:0 auto;
        }
        .intro-loader-track {
            height:6px;
            border-radius:999px;
            background:rgba(255,255,255,.08);
            overflow:hidden;
            box-shadow:inset 0 1px 3px rgba(0,0,0,.55);
        }
        .intro-loader-bar {
            width:0%;
            height:100%;
            border-radius:inherit;
            background:linear-gradient(90deg,#b91c1c,#ef4444,#f97316,#facc15);
            box-shadow:0 0 18px rgba(249,115,22,.55);
        }
        .intro-loader-meta {
            display:flex;
            align-items:center;
            justify-content:space-between;
            margin-top:8px;
            color:#a1a1aa;
            font-size:10px;
            letter-spacing:.04em;
        }
        .intro-percent { color:#fed7aa; font-weight:800; min-width:38px; text-align:right; }
        .intro-credit {
            margin-top:18px;
            color:#71717a;
            font-size:10px;
            letter-spacing:.12em;
            text-transform:uppercase;
        }
        .intro-credit strong { color:#a1a1aa; font-weight:700; }
        .intro-corner {
            position:absolute;
            width:70px;
            height:70px;
            border-color:rgba(249,115,22,.25);
            pointer-events:none;
        }
        .intro-corner.tl { top:8px; left:8px; border-top:1px solid; border-left:1px solid; }
        .intro-corner.tr { top:8px; right:8px; border-top:1px solid; border-right:1px solid; }
        .intro-corner.bl { bottom:8px; left:8px; border-bottom:1px solid; border-left:1px solid; }
        .intro-corner.br { bottom:8px; right:8px; border-bottom:1px solid; border-right:1px solid; }
        @keyframes introPulse { 0%,100%{transform:scale(.96);opacity:.55} 50%{transform:scale(1.04);opacity:1} }
        @keyframes spinRing { from{transform:rotate(0)} to{transform:rotate(360deg)} }
        @keyframes spinRingReverse { from{transform:rotate(360deg)} to{transform:rotate(0)} }
        @keyframes logoFloat { 0%,100%{transform:translateY(0) scale(1)} 50%{transform:translateY(-5px) scale(1.015)} }
        @media (max-width:640px){
            .intro-shell{padding:20px 14px 18px;}
            .intro-logo-wrap{margin-bottom:14px;}
            .intro-features{gap:6px;margin-top:14px;margin-bottom:15px;}
            .intro-feature{font-size:10px;padding:6px 8px;}
            .intro-credit{margin-top:14px;}
        }
        @media (prefers-reduced-motion:reduce){
            .intro-overlay::after,.intro-logo-wrap::before,.intro-logo-wrap::after,.intro-logo{animation:none !important;}
        }
    </style>
</head>
<body class="bg-gray-100 text-zinc-100 font-sans min-h-screen splash-active">

    <!-- Professional 4-second application introduction -->
    <section id="intro-overlay" class="intro-overlay" aria-label="Bin Card Admin Panel introduction" aria-hidden="false">
        <div class="intro-shell">
            <span class="intro-corner tl"></span><span class="intro-corner tr"></span>
            <span class="intro-corner bl"></span><span class="intro-corner br"></span>

            <div class="intro-logo-wrap">
                <img id="intro-logo" class="intro-logo" src="" alt="Bin Card Admin Panel Logo">
            </div>

            <div class="intro-kicker"><i class="fas fa-shield-halved"></i> Secure Inventory Workspace</div>
            <h1 class="intro-title">Bin Card Admin Panel</h1>
            <p class="intro-subtitle">
                භාණ්ඩ ලියාපදිංචි කිරීම, Opening Stock කළමනාකරණය, QR Codes හරහා Bin Card වෙත ප්‍රවේශය සහ Inventory තොරතුරු කාර්යක්ෂමව පාලනය කිරීම සඳහා නිර්මාණය කළ Admin Web App එකකි.
            </p>

            <div class="intro-features" aria-label="Application features">
                <span class="intro-feature"><i class="fas fa-boxes-stacked"></i> Item Management</span>
                <span class="intro-feature"><i class="fas fa-file-excel"></i> Excel Import</span>
                <span class="intro-feature"><i class="fas fa-qrcode"></i> QR / Bin Card</span>
                <span class="intro-feature"><i class="fas fa-file-pdf"></i> PDF Reports</span>
            </div>

            <div class="intro-loader" aria-label="Loading application">
                <div class="intro-loader-track"><div id="intro-loader-bar" class="intro-loader-bar"></div></div>
                <div class="intro-loader-meta">
                    <span id="intro-loader-status">Preparing your workspace...</span>
                    <span id="intro-percent" class="intro-percent">0%</span>
                </div>
            </div>

            <p class="intro-credit">Create By <strong>Yomal Lakshan</strong></p>
        </div>
    </section>

    <header class="app-header text-white py-4 px-4 sm:px-6 mb-6">
        <div class="container mx-auto max-w-6xl flex items-center justify-between gap-4">
            <div class="flex items-center gap-3 min-w-0">
                <img class="app-logo" src="data:image/png;base64," alt="Bin Card Admin Panel Logo">
                <div class="min-w-0"><h1 class="brand-title text-xl sm:text-2xl font-black tracking-wide truncate">Bin Card Admin Panel</h1><p class="text-xs sm:text-sm text-orange-200/80 flex items-center gap-2"><i class="fas fa-boxes-stacked"></i> Inventory & Bin Card Management</p></div>
            </div>
            <div class="hidden sm:flex items-center gap-2 text-xs text-orange-100/70"><i class="fas fa-fire text-orange-400"></i> Inventory Management</div>
        </div>
    </header>

    <main class="container mx-auto px-4 max-w-6xl pb-12">
        <div class="text-center mb-5"><div class="section-glow mb-4"></div><p class="text-xs sm:text-sm text-zinc-400">Store Inventory Management System</p></div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="fire-input-card rounded-2xl shadow-md p-6">
                <h2 class="text-lg font-bold text-zinc-100 mb-2 flex items-center gap-2">
                    <i class="fas fa-file-excel text-green-600"></i> 1. Upload Items (.xlsx)
                </h2>
                <p class="text-xs text-zinc-400 mb-4">
                    Excel Sheet එකෙන් <b>B Column (Code)</b> සහ <b>C Column (Name)</b> ලබාගනී.
                </p>
                <div id="drop-zone-items" class="drop-zone rounded-xl p-6 text-center cursor-pointer bg-gray-50 hover:bg-blue-50">
                    <i class="fas fa-cloud-upload-alt text-4xl text-blue-500 mb-2"></i>
                    <p class="text-sm font-semibold text-zinc-200">Drag & Drop Items XLSX file here</p>
                    <p class="text-xs text-zinc-500 mt-1">or click to browse files</p>
                    <input type="file" id="file-input-items" accept=".xlsx, .xls" class="hidden">
                </div>
            </div>

            <div class="fire-input-card rounded-2xl shadow-md p-6">
                <h2 class="text-lg font-bold text-zinc-100 mb-2 flex items-center gap-2">
                    <i class="fas fa-cubes text-blue-600"></i> 2. Upload Opening Stock (.xlsx)
                </h2>
                <p class="text-xs text-zinc-400 mb-4">
                    Excel Sheet එකෙන් <b>B (Code)</b>, <b>C (Name)</b> සහ <b>E Column (Opening Stock)</b> ලබාගනී.
                </p>
                <div id="drop-zone-stock" class="drop-zone rounded-xl p-6 text-center cursor-pointer bg-gray-50 hover:bg-green-50">
                    <i class="fas fa-file-import text-4xl text-green-500 mb-2"></i>
                    <p class="text-sm font-semibold text-zinc-200">Drag & Drop Opening Stock XLSX file here</p>
                    <p class="text-xs text-zinc-500 mt-1">or click to browse files</p>
                    <input type="file" id="file-input-stock" accept=".xlsx, .xls" class="hidden">
                </div>
            </div>
        </div>

        <button id="registered-toggle" type="button" onclick="toggleRegisteredItems()" aria-expanded="false" aria-controls="registered-items-section" class="details-toggle w-full rounded-2xl px-5 py-4 text-white font-bold flex items-center justify-between gap-4 transition">
            <span class="flex items-center gap-3 min-w-0 text-left"><span class="w-10 h-10 rounded-xl bg-black/30 flex items-center justify-center shrink-0"><i class="fas fa-qrcode text-yellow-300"></i></span><span class="min-w-0"><span class="block text-sm sm:text-base">Registered Items & QR Codes</span><span class="block text-[11px] sm:text-xs text-orange-100/80 font-normal mt-0.5">විස්තර අවශ්‍ය විට පමණක් බලන්න</span></span></span>
            <span id="registered-toggle-icon" class="w-9 h-9 rounded-full bg-black/25 flex items-center justify-center shrink-0 transition-transform"><i class="fas fa-chevron-down"></i></span>
        </button>
        <div id="registered-items-section" class="registered-section" aria-hidden="true">
        <div class="fire-panel rounded-2xl shadow-md p-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6 border-b border-zinc-700 pb-4">
                <div><h2 class="text-xl font-bold text-zinc-100 flex items-center gap-2"><i class="fas fa-qrcode text-orange-400"></i> Registered Items & QR Codes</h2><p class="text-xs text-zinc-400 mt-1">QR code එක scan කිරීමෙන් අදාල Item එකේ Bin Card පිටුව විවෘත වේ</p></div>
                <div class="flex items-center gap-2 w-full sm:w-auto">
                    <button onclick="downloadAllBinCardsZIP()" class="fire-button text-white text-sm font-semibold py-2 px-3 rounded-lg shadow transition flex items-center justify-center gap-2" title="Download all Bin Cards as ZIP" aria-label="Download all Bin Cards as ZIP">
                        <i class="fas fa-file-zipper"></i><span class="hidden sm:inline">ZIP</span>
                    </button>
                    <button onclick="downloadRegisteredItemsPDF()" class="fire-button text-white text-sm font-semibold py-2 px-3 rounded-lg shadow transition flex items-center justify-center gap-2" title="Download PDF"><i class="fas fa-file-pdf"></i><span class="hidden sm:inline">PDF</span></button>
                    <button onclick="loadItemsFromFirebase()" class="fire-button text-white text-sm font-semibold py-2 px-4 rounded-lg shadow transition flex items-center justify-center gap-2 flex-1 sm:flex-none"><i class="fas fa-sync-alt"></i> Refresh Items List</button>
                </div>
            </div>

            <!-- Desktop table -->
            <div class="hidden md:block overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-gray-800 text-white text-sm">
                            <th class="p-3 rounded-tl-lg">Material Code (Col B)</th>
                            <th class="p-3">Material Name (Col C)</th>
                            <th class="p-3 text-center">Opening Stock (Col E)</th>
                            <th class="p-3 text-center rounded-tr-lg">QR Code</th>
                        </tr>
                    </thead>
                    <tbody id="items-table-body" class="divide-y divide-zinc-800 text-sm">
                        <tr><td colspan="4" class="p-6 text-center text-zinc-500">Loading items...</td></tr>
                    </tbody>
                </table>
            </div>

            <!-- Mobile item cards -->
            <div id="items-card-container" class="md:hidden grid grid-cols-1 gap-4">
                <div class="bg-zinc-900 rounded-xl p-6 text-center text-zinc-500 border border-zinc-800">Loading items...</div>
            </div>
        </div>
        </div>

    </main>

    <script>
        let registeredItemsCache = [];
        let qrRenderQueued = false;

        function toggleRegisteredItems() {
            const section = document.getElementById('registered-items-section');
            const button = document.getElementById('registered-toggle');
            const icon = document.getElementById('registered-toggle-icon');
            if (!section || !button || !icon) return;

            const isOpen = section.classList.toggle('is-open');
            section.setAttribute('aria-hidden', String(!isOpen));
            button.setAttribute('aria-expanded', String(isOpen));
            icon.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';

            // QR generation is intentionally deferred until the panel is visible.
            if (isOpen && !qrRenderQueued) {
                qrRenderQueued = true;
                requestAnimationFrame(() => {
                    qrRenderQueued = false;
                    renderVisibleItemQRCodes();
                });
            }
        }

        function scheduleIdleTask(fn) {
            if ('requestIdleCallback' in window) {
                window.requestIdleCallback(fn, { timeout: 600 });
            } else {
                setTimeout(fn, 16);
            }
        }

        function renderVisibleItemQRCodes() {
            if (!window.QRCode || !registeredItemsCache.length) return;

            let index = 0;
            const total = registeredItemsCache.length;

            const renderChunk = () => {
                const end = Math.min(index + 8, total);

                for (; index < end; index++) {
                    const item = registeredItemsCache[index];
                    const safeCodeId = item.safeCodeId;
                    const desktop = document.getElementById(`qr-container-${safeCodeId}`);
                    const mobile = document.getElementById(`mobile-qr-container-${safeCodeId}`);

                    try {
                        if (desktop && !desktop.dataset.qrReady) {
                            desktop.innerHTML = '';
                            new QRCode(desktop, {
                                text: item.url,
                                width: 80,
                                height: 80,
                                correctLevel: QRCode.CorrectLevel.M
                            });
                            desktop.dataset.qrReady = '1';
                        }

                        if (mobile && !mobile.dataset.qrReady) {
                            mobile.innerHTML = '';
                            new QRCode(mobile, {
                                text: item.url,
                                width: 72,
                                height: 72,
                                correctLevel: QRCode.CorrectLevel.M
                            });
                            mobile.dataset.qrReady = '1';
                        }
                    } catch (e) {
                        console.warn('QR render skipped:', e);
                    }
                }

                if (index < total) scheduleIdleTask(renderChunk);
            };

            scheduleIdleTask(renderChunk);
        }

        const firebaseConfig = {
            apiKey: "AIzaSyDUbL9Q28whHtrJ1Q-J1HzFO-ybQa11y0U",
            authDomain: "qr-to-bin-card.firebaseapp.com",
            projectId: "qr-to-bin-card",
            storageBucket: "qr-to-bin-card.firebasestorage.app",
            messagingSenderId: "64518992022",
            appId: "1:64518992022:web:4e55b994b91765064ad2b7",
            measurementId: "G-9PHQBG7F88"
        };

        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();

        function setupDragAndDrop(zoneId, inputId, handleFileFn) {
            const dropZone = document.getElementById(zoneId);
            const fileInput = document.getElementById(inputId);

            dropZone.addEventListener('click', () => fileInput.click());
            dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.classList.add('dragover');
            });
            dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('dragover');
                if (e.dataTransfer.files.length > 0) {
                    handleFileFn(e.dataTransfer.files[0]);
                }
            });
            fileInput.addEventListener('change', (e) => {
                if (e.target.files.length > 0) {
                    handleFileFn(e.target.files[0]);
                }
            });
        }

        setupDragAndDrop('drop-zone-items', 'file-input-items', processItemsExcel);
        setupDragAndDrop('drop-zone-stock', 'file-input-stock', processStockExcel);

        function readExcelFile(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onload = (e) => {
                    try {
                        const data = new Uint8Array(e.target.result);
                        const workbook = XLSX.read(data, { type: 'array' });
                        if (!workbook.SheetNames || workbook.SheetNames.length === 0) {
                            throw new Error("Excel ගොනුවේ කිසිදු Sheet එකක් සොයා ගැනීමට නොහැකි විය.");
                        }
                        const firstSheetName = workbook.SheetNames[0];
                        const worksheet = workbook.Sheets[firstSheetName];
                        const json = XLSX.utils.sheet_to_json(worksheet, { header: 1, defval: "" });
                        resolve(json);
                    } catch (err) {
                        reject(err);
                    }
                };
                reader.onerror = () => reject(new Error("File එක කියවීමට නොහැකි විය."));
                reader.readAsArrayBuffer(file);
            });
        }

        async function processItemsExcel(file) {
            try {
                Swal.fire({ title: 'Processing Items...', text: 'Excel data batch එකක් ලෙස ඇතුළත් කරමින්...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

                const rows = await readExcelFile(file);
                const writes = [];
                const seen = new Set();

                for (let i = 1; i < rows.length; i++) {
                    const row = rows[i];
                    if (!row || row.length < 2) continue;

                    const code = row[1] !== undefined ? String(row[1]).trim() : "";
                    const name = row[2] !== undefined ? String(row[2]).trim() : "";
                    if (!code || seen.has(code)) continue;

                    seen.add(code);
                    writes.push({
                        id: code.replace(/\//g, '_'),
                        data: { materialCode: code, materialName: name }
                    });
                }

                let addedCount = 0;
                let errorCount = 0;

                // Firestore batches have a 500-operation limit.
                for (let i = 0; i < writes.length; i += 450) {
                    const batch = db.batch();
                    const chunk = writes.slice(i, i + 450);

                    chunk.forEach(item => {
                        batch.set(db.collection('items').doc(item.id), item.data, { merge: true });
                    });

                    try {
                        await batch.commit();
                        addedCount += chunk.length;
                    } catch (e) {
                        console.error("Firestore Batch Error:", e);
                        errorCount += chunk.length;
                    }

                    await new Promise(resolve => setTimeout(resolve, 0));
                }

                if (errorCount > 0) {
                    Swal.fire('අවවාදයයි!', `අයිතම ${addedCount} ක් ඇතුළත් විය. නමුත් ${errorCount} ක දෝෂ ඇති විය. Firebase Rules පරීක්ෂා කරන්න.`, 'warning');
                } else {
                    Swal.fire('සාර්ථකයි!', `අයිතම ${addedCount} ක් සාර්ථකව ඇතුළත් කරන ලදී!`, 'success');
                }

                await loadItemsFromFirebase();
            } catch (err) {
                console.error(err);
                Swal.fire('දෝෂයක් සිදු විය', `Excel file එක කියවීමේදී දෝෂයක් විය: ${err.message || err}`, 'error');
            }
        }

        async function processStockExcel(file) {
            try {
                Swal.fire({ title: 'Updating Opening Stock...', text: 'Opening Stock batch එකක් ලෙස update කරමින්...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

                const rows = await readExcelFile(file);
                const writes = [];
                const seen = new Set();

                for (let i = 1; i < rows.length; i++) {
                    const row = rows[i];
                    if (!row) continue;

                    const code = row[1] !== undefined ? String(row[1]).trim() : "";
                    const name = row[2] !== undefined ? String(row[2]).trim() : "";
                    const rawStock = row[4] !== undefined ? String(row[4]).trim() : "0";
                    const opStockVal = parseFloat(rawStock) || 0;

                    if (!code || seen.has(code)) continue;

                    seen.add(code);
                    const payload = {
                        materialCode: code,
                        openingStock: opStockVal
                    };
                    if (name !== "") payload.materialName = name;

                    writes.push({
                        id: code.replace(/\//g, '_'),
                        data: payload
                    });
                }

                let updatedCount = 0;
                let errorCount = 0;

                for (let i = 0; i < writes.length; i += 450) {
                    const batch = db.batch();
                    const chunk = writes.slice(i, i + 450);

                    chunk.forEach(item => {
                        batch.set(db.collection('items').doc(item.id), item.data, { merge: true });
                    });

                    try {
                        await batch.commit();
                        updatedCount += chunk.length;
                    } catch (e) {
                        console.error("Firestore Stock Batch Error:", e);
                        errorCount += chunk.length;
                    }

                    await new Promise(resolve => setTimeout(resolve, 0));
                }

                if (errorCount > 0) {
                    Swal.fire('අවවාදයයි!', `Opening Stock ${updatedCount} ක් update විය. නමුත් ${errorCount} ක දෝෂ ඇති විය. Firebase Rules පරීක්ෂා කරන්න.`, 'warning');
                } else {
                    Swal.fire('සාර්ථකයි!', `Opening Stock අගයන් ${updatedCount} ක් සාර්ථකව update කරන ලදී!`, 'success');
                }

                await loadItemsFromFirebase();
            } catch (err) {
                console.error(err);
                Swal.fire('දෝෂයක් සිදු විය', `Opening Stock Excel file එක කියවීමේදී දෝෂයක් විය: ${err.message || err}`, 'error');
            }
        }

        // ==========================================
        // OPAQUE ITEM URL TOKEN
        // ==========================================
        // Keep this in sync with item.html.
        // This hides material codes from normal URLs; real access control
        // must still be enforced with Firebase Authentication/Firestore Rules.
        const ITEM_URL_SECRET = 'BinCard-Item-URL-v2-2026';

        function bytesToBase64Url(bytes) {
            let binary = '';
            bytes.forEach(b => binary += String.fromCharCode(b));
            return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/g, '');
        }

        async function getItemCryptoKey() {
            const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(ITEM_URL_SECRET));
            return crypto.subtle.importKey('raw', digest, { name: 'AES-GCM' }, false, ['encrypt']);
        }

        async function createItemToken(materialCode) {
            const key = await getItemCryptoKey();
            const iv = crypto.getRandomValues(new Uint8Array(12));
            const ciphertext = await crypto.subtle.encrypt({ name: 'AES-GCM', iv }, key, new TextEncoder().encode(String(materialCode || '').trim()));
            const combined = new Uint8Array(iv.length + ciphertext.byteLength);
            combined.set(iv, 0);
            combined.set(new Uint8Array(ciphertext), iv.length);
            return bytesToBase64Url(combined);
        }

        async function loadItemsFromFirebase() {
            const tbody = document.getElementById('items-table-body');
            const cardContainer = document.getElementById('items-card-container');

            if (!tbody || !cardContainer) return;

            tbody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-zinc-400">Loading data...</td></tr>`;
            cardContainer.innerHTML = `<div class="bg-gray-50 rounded-xl p-6 text-center text-zinc-400">Loading data...</div>`;

            try {
                let snapshot = await db.collection('items').get();
                let sourceItems = registeredItemsCache;

                if (!sourceItems.length) {
                    sourceItems = [];
                    snapshot.forEach(doc => {
                        const item = doc.data() || {};
                        const code = String(item.materialCode || doc.id).trim();
                        if (!code) return;
                        sourceItems.push({
                            code,
                            name: String(item.materialName || '-').trim() || '-'
                        });
                    });
                }

                if (!sourceItems.length) {
                    registeredItemsCache = [];
                    tbody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-zinc-400">තවමත් කිසිදු අයිතමයක් ඇතුලත් කර නොමැත. Excel file එකක් upload කරන්න.</td></tr>`;
                    cardContainer.innerHTML = `<div class="bg-gray-50 rounded-xl p-6 text-center text-zinc-400">තවමත් කිසිදු අයිතමයක් ඇතුලත් කර නොමැත. Excel file එකක් upload කරන්න.</div>`;
                    return;
                }

                const currentUrl = window.location.href;
                const baseUrl = currentUrl.split('?')[0].replace('index.html', '').replace(/\/$/, '') + '/item.html';

                const fragment = document.createDocumentFragment();
                const cardFragment = document.createDocumentFragment();
                const items = [];

                snapshot.forEach(doc => {
                    const item = doc.data() || {};
                    const code = String(item.materialCode || doc.id).trim();
                    if (!code) return;

                    const name = String(item.materialName || '-').trim() || '-';
                    const opStock = item.openingStock !== undefined ? item.openingStock : 0;
                    const safeCodeId = doc.id;
                    const itemToken = await createItemToken(code);
                    const itemPageUrl = `${baseUrl}#item=${itemToken}`;

                    items.push({ code, name, opStock, safeCodeId, url: itemPageUrl });

                    const tr = document.createElement('tr');
                    tr.className = "hover:bg-gray-50 transition border-b";
                    tr.innerHTML = `
                        <td class="p-3 font-bold text-blue-700">${escapeHtml(code)}</td>
                        <td class="p-3 font-medium text-zinc-100">${escapeHtml(name)}</td>
                        <td class="p-3 text-center font-semibold text-green-700">${escapeHtml(String(opStock))}</td>
                        <td class="p-3 text-center">
                            <div class="flex flex-col items-center justify-center gap-1">
                                <div id="qr-container-${safeCodeId}" class="p-1 bg-white border rounded shadow-sm inline-block"></div>
                                <a href="${itemPageUrl}" target="_blank" class="text-xs text-blue-600 hover:underline flex items-center gap-1 mt-1">
                                    <i class="fas fa-external-link-alt"></i> Open Page
                                </a>
                            </div>
                        </td>`;
                    fragment.appendChild(tr);

                    const card = document.createElement('div');
                    card.className = "bg-white rounded-2xl shadow-md border border-gray-100 p-4 overflow-hidden";
                    card.innerHTML = `
                        <div class="flex items-start justify-between gap-3 mb-3">
                            <div class="min-w-0">
                                <div class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">Material Code</div>
                                <div class="font-bold text-blue-700 text-base break-all">${escapeHtml(code)}</div>
                            </div>
                            <div class="bg-purple-50 border border-purple-100 rounded-xl p-2 shrink-0">
                                <div id="mobile-qr-container-${safeCodeId}" class="bg-white"></div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <div class="text-[10px] font-bold uppercase tracking-wider text-zinc-500">Material Name</div>
                            <div class="font-semibold text-zinc-100 text-sm break-words">${escapeHtml(name)}</div>
                        </div>
                        <div class="flex items-center justify-between bg-green-50 border border-green-100 rounded-xl px-3 py-2.5 mb-3">
                            <span class="text-xs font-bold text-green-700">Opening Stock</span>
                            <span class="text-lg font-black text-green-800">${escapeHtml(String(opStock))}</span>
                        </div>
                        <a href="${itemPageUrl}" target="_blank" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2.5 rounded-xl text-sm font-bold flex items-center justify-center gap-2 transition">
                            <i class="fas fa-external-link-alt"></i> Open Bin Card
                        </a>`;
                    cardFragment.appendChild(card);
                });

                items.sort((a, b) => a.code.localeCompare(b.code, undefined, { numeric: true, sensitivity: 'base' }));
                registeredItemsCache = items;

                tbody.innerHTML = '';
                cardContainer.innerHTML = '';
                tbody.appendChild(fragment);
                cardContainer.appendChild(cardFragment);

                // Do not generate hundreds of QR codes while the panel is collapsed.
                if (document.getElementById('registered-items-section')?.classList.contains('is-open')) {
                    renderVisibleItemQRCodes();
                }
            } catch (err) {
                console.error("Load Data Error:", err);
                if(err.code === 'permission-denied') {
                    tbody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-red-500 font-bold">Permissions Denied! <br> කරුණාකර Firebase Firestore Rules පරීක්ෂා කරන්න.</td></tr>`;
                    cardContainer.innerHTML = `<div class="bg-red-50 rounded-xl p-6 text-center text-red-500 font-bold">Permissions Denied!</div>`;
                    Swal.fire('Permission Error', 'ඔබට දත්ත කියවීමට හෝ ලිවීමට අවසර නොමැත. කරුණාකර Firebase Rules යාවත්කාලීන කරන්න.', 'error');
                } else {
                    tbody.innerHTML = `<tr><td colspan="4" class="p-6 text-center text-red-500">දත්ත ලබාගැනීමේදී දෝෂයක් සිදු විය.</td></tr>`;
                    cardContainer.innerHTML = `<div class="bg-red-50 rounded-xl p-6 text-center text-red-500">දත්ත ලබාගැනීමේදී දෝෂයක් සිදු විය.</div>`;
                }
            }
        }

        function escapeHtml(value) {
            return String(value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function createPDFQRCodeDataURL(text, size = 100) {
            return new Promise((resolve, reject) => {
                if (!window.QRCode) {
                    reject(new Error("QR Code library එක load වී නොමැත."));
                    return;
                }

                const holder = document.createElement('div');
                holder.style.position = 'fixed';
                holder.style.left = '-10000px';
                holder.style.top = '-10000px';
                holder.style.width = `${size}px`;
                holder.style.height = `${size}px`;
                holder.style.background = '#ffffff';
                document.body.appendChild(holder);

                try {
                    new QRCode(holder, {
                        text: String(text),
                        width: size,
                        height: size,
                        colorDark: '#000000',
                        colorLight: '#ffffff',
                        correctLevel: QRCode.CorrectLevel.M
                    });

                    setTimeout(() => {
                        try {
                            const canvas = holder.querySelector('canvas');
                            const img = holder.querySelector('img');

                            if (canvas) {
                                resolve(canvas.toDataURL('image/png'));
                            } else if (img && img.src) {
                                resolve(img.src);
                            } else {
                                reject(new Error("QR Code image එක generate කිරීමට නොහැකි විය."));
                            }
                        } catch (e) {
                            reject(e);
                        } finally {
                            holder.remove();
                        }
                    }, 100);
                } catch (e) {
                    holder.remove();
                    reject(e);
                }
            });
        }

        function safeFileName(value, fallback = 'Item') {
            const cleaned = String(value || fallback)
                .replace(/[<>:"/\\|?*\x00-\x1F]/g, ' ')
                .replace(/\s+/g, ' ')
                .trim()
                .replace(/[. ]+$/g, '');
            return (cleaned || fallback).slice(0, 120);
        }

        function buildBinCardRows(item, transactionGroups) {
            const transactions = (transactionGroups.get(item.code) || [])
                .slice()
                .sort((a, b) => String(a.date || '').localeCompare(String(b.date || '')));

            let running = Number(item.opStock) || 0;
            const rows = transactions.map(trx => {
                const receive = Number(trx.receive || 0);
                const issue = Number(trx.issue || 0);
                const returned = Number(trx.return || 0);
                const opening = running;
                const closing = opening + receive + returned - issue;
                running = closing;

                return {
                    date: trx.date || '',
                    opening,
                    receive,
                    issue,
                    returned,
                    closing
                };
            });

            return { rows, closing: running };
        }

        function createBinCardPDF(item, transactionGroups) {
            const { jsPDF } = window.jspdf || {};
            if (!jsPDF) throw new Error('jsPDF library එක load වී නොමැත.');

            const pdf = new jsPDF({
                orientation: 'landscape',
                unit: 'mm',
                format: 'a4',
                compress: true
            });

            const pageWidth = pdf.internal.pageSize.getWidth();
            const pageHeight = pdf.internal.pageSize.getHeight();
            const margin = 10;
            const { rows, closing } = buildBinCardRows(item, transactionGroups);

            pdf.setFillColor(9, 9, 11);
            pdf.rect(0, 0, pageWidth, 22, 'F');

            pdf.setTextColor(255, 255, 255);
            pdf.setFont('helvetica', 'bold');
            pdf.setFontSize(17);
            pdf.text('BIN CARD', margin, 10);

            pdf.setFontSize(8.5);
            pdf.setFont('helvetica', 'normal');
            pdf.text('Bin Card Admin Panel - Item Movement Report', margin, 16);

            pdf.setTextColor(20, 20, 20);
            pdf.setFont('helvetica', 'bold');
            pdf.setFontSize(11);
            pdf.text(`Material Code: ${String(item.code)}`, margin, 31);
            pdf.text(`Material Name: ${String(item.name)}`, margin, 38);

            pdf.setFontSize(10);
            pdf.setTextColor(30, 100, 60);
            pdf.text(`Opening Stock: ${Number(item.opStock) || 0}`, pageWidth - 72, 31);
            pdf.setTextColor(30, 70, 150);
            pdf.text(`Closing Stock: ${closing}`, pageWidth - 72, 38);

            const body = rows.length
                ? rows.map(r => [
                    r.date,
                    String(r.opening),
                    r.receive ? `+${r.receive}` : '-',
                    r.issue ? `-${r.issue}` : '-',
                    r.returned ? `+${r.returned}` : '-',
                    String(r.closing)
                ])
                : [[
                    '-', String(Number(item.opStock) || 0), '-', '-', '-',
                    String(Number(item.opStock) || 0)
                ]];

            if (typeof pdf.autoTable === 'function') {
                pdf.autoTable({
                    startY: 46,
                    margin: { left: margin, right: margin },
                    head: [['Date', 'Opening Stock', 'Receive (+)', 'Issue (-)', 'Return (+)', 'Closing Stock']],
                    body,
                    theme: 'grid',
                    styles: {
                        font: 'helvetica',
                        fontSize: 9,
                        cellPadding: 3,
                        textColor: [35, 35, 35]
                    },
                    headStyles: {
                        fillColor: [31, 41, 55],
                        textColor: [255, 255, 255],
                        fontStyle: 'bold'
                    },
                    columnStyles: {
                        0: { cellWidth: 38 },
                        1: { halign: 'right' },
                        2: { halign: 'right' },
                        3: { halign: 'right' },
                        4: { halign: 'right' },
                        5: { halign: 'right', fontStyle: 'bold' }
                    },
                    didDrawPage: () => {
                        pdf.setFontSize(7.5);
                        pdf.setTextColor(110, 110, 110);
                        pdf.text(
                            `Generated: ${new Date().toLocaleString()}`,
                            margin,
                            pageHeight - 7
                        );
                        pdf.text(
                            `Page ${pdf.internal.getNumberOfPages()}`,
                            pageWidth - margin,
                            pageHeight - 7,
                            { align: 'right' }
                        );
                    }
                });
            } else {
                let y = 50;
                pdf.setFontSize(9);
                body.forEach(row => {
                    pdf.text(row.join(' | '), margin, y);
                    y += 7;
                    if (y > pageHeight - 12) {
                        pdf.addPage();
                        y = 15;
                    }
                });
            }

            return pdf;
        }

        async function downloadAllBinCardsZIP() {
            try {
                if (!window.JSZip) throw new Error('JSZip library එක load වී නොමැත.');
                if (!window.jspdf?.jsPDF) throw new Error('jsPDF library එක load වී නොමැත.');

                Swal.fire({
                    title: 'Preparing Bin Card ZIP...',
                    html: 'Items සහ transactions එකතු කරමින්...<br><b id="zip-progress">0%</b>',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });

                // One items read + one transactions read instead of one transaction query per item.
                const [itemsSnapshot, transactionsSnapshot] = await Promise.all([
                    db.collection('items').get(),
                    db.collection('transactions').get()
                ]);

                if (itemsSnapshot.empty) {
                    Swal.close();
                    await Swal.fire('No Items', 'ZIP සඳහා Registered Items නොමැත.', 'info');
                    return;
                }

                const transactionGroups = new Map();
                transactionsSnapshot.forEach(doc => {
                    const trx = doc.data() || {};
                    const code = String(trx.materialCode || '').trim();
                    if (!code) return;
                    if (!transactionGroups.has(code)) transactionGroups.set(code, []);
                    transactionGroups.get(code).push(trx);
                });

                const items = [];
                itemsSnapshot.forEach(doc => {
                    const item = doc.data() || {};
                    const code = String(item.materialCode || doc.id).trim();
                    if (!code) return;

                    items.push({
                        code,
                        name: String(item.materialName || 'Unnamed Item').trim() || 'Unnamed Item',
                        opStock: Number(item.openingStock || 0),
                        safeCodeId: doc.id
                    });
                });

                items.sort((a, b) => a.name.localeCompare(b.name, undefined, {
                    numeric: true,
                    sensitivity: 'base'
                }));

                const zip = new JSZip();
                const usedFolders = new Set();

                for (let index = 0; index < items.length; index++) {
                    const item = items[index];

                    let folderName = safeFileName(item.name, `Item-${item.code}`);
                    if (usedFolders.has(folderName.toLowerCase())) {
                        folderName = `${folderName} - ${safeFileName(item.code, 'Code')}`;
                    }
                    usedFolders.add(folderName.toLowerCase());

                    const pdf = createBinCardPDF(item, transactionGroups);
                    const pdfBlob = pdf.output('blob');

                    // Each item gets its own folder containing its Bin Card PDF.
                    zip.folder(folderName).file(
                        `${folderName} - Bin Card.pdf`,
                        pdfBlob
                    );

                    const percent = Math.round(((index + 1) / items.length) * 100);
                    const progressEl = document.getElementById('zip-progress');
                    if (progressEl) progressEl.textContent = `${percent}%`;

                    // Give the browser a frame between batches so the UI remains responsive.
                    if ((index + 1) % 5 === 0) {
                        await new Promise(resolve => setTimeout(resolve, 0));
                    }
                }

                const zipBlob = await zip.generateAsync(
                    {
                        type: 'blob',
                        compression: 'DEFLATE',
                        compressionOptions: { level: 6 }
                    },
                    metadata => {
                        const progressEl = document.getElementById('zip-progress');
                        if (progressEl) progressEl.textContent = `${Math.round(metadata.percent)}%`;
                    }
                );

                const date = new Date().toISOString().slice(0, 10);
                const url = URL.createObjectURL(zipBlob);
                const link = document.createElement('a');
                link.href = url;
                link.download = `All-Bin-Cards-${date}.zip`;
                document.body.appendChild(link);
                link.click();
                link.remove();
                setTimeout(() => URL.revokeObjectURL(url), 30000);

                Swal.close();
                await Swal.fire({
                    icon: 'success',
                    title: 'ZIP Downloaded',
                    text: `${items.length} item folders සහ ඒවාට අදාළ Bin Card PDF files ඇතුළත් ZIP එක සූදානම්.`,
                    timer: 2500,
                    showConfirmButton: false
                });
            } catch (err) {
                console.error('Bin Card ZIP Export Error:', err);
                Swal.close();
                Swal.fire(
                    'ZIP Error',
                    'Bin Card ZIP එක සෑදීමේදී දෝෂයක් සිදු විය: ' + (err.message || err),
                    'error'
                );
            }
        }

        async function downloadRegisteredItemsPDF() {
            try {
                Swal.fire({
                    title: 'Preparing PDF...',
                    text: 'Material Code, Material Name සහ QR Codes සකස් කරමින්...',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading()
                });

                const snapshot = await db.collection('items').get();

                if (snapshot.empty) {
                    Swal.close();
                    Swal.fire(
                        'No Items',
                        'PDF සඳහා Registered Items නොමැත.',
                        'info'
                    );
                    return;
                }

                const items = sourceItems.map(item => {
                    const itemPageUrl =
                        new URL('item.html', new URL('.', window.location.href));
                    itemPageUrl.searchParams.set('code', item.code);

                    return {
                        code: item.code,
                        name: item.name,
                        url: itemPageUrl.href
                    };
                });

                items.sort((a, b) =>
                    a.code.localeCompare(b.code, undefined, {
                        numeric: true,
                        sensitivity: 'base'
                    })
                );

                if (!items.length) {
                    Swal.close();
                    Swal.fire(
                        'No Items',
                        'PDF සඳහා valid Registered Items නොමැත.',
                        'info'
                    );
                    return;
                }

                const { jsPDF } = window.jspdf;

                if (!jsPDF) {
                    throw new Error('jsPDF library එක load වී නොමැත.');
                }

                const pdf = new jsPDF({
                    orientation: 'landscape',
                    unit: 'mm',
                    format: 'a4'
                });

                const pageWidth = pdf.internal.pageSize.getWidth();
                const pageHeight = pdf.internal.pageSize.getHeight();

                const margin = 10;
                const rowHeight = 42;
                const qrSize = 32;

                let y = 14;

                function drawHeader() {
                    pdf.setFont('helvetica', 'bold');
                    pdf.setFontSize(17);
                    pdf.setTextColor(31, 41, 55);

                    pdf.text(
                        'Registered Items & QR Codes',
                        pageWidth / 2,
                        y,
                        { align: 'center' }
                    );

                    y += 6;

                    pdf.setFont('helvetica', 'normal');
                    pdf.setFontSize(8);
                    pdf.setTextColor(107, 114, 128);

                    pdf.text(
                        `Generated: ${new Date().toLocaleString()}`,
                        pageWidth / 2,
                        y,
                        { align: 'center' }
                    );

                    y += 7;

                    pdf.setFillColor(31, 41, 55);
                    pdf.rect(
                        margin,
                        y,
                        pageWidth - (margin * 2),
                        9,
                        'F'
                    );

                    pdf.setFont('helvetica', 'bold');
                    pdf.setFontSize(8);
                    pdf.setTextColor(255, 255, 255);

                    pdf.text('No.', 14, y + 6);
                    pdf.text('Material Code', 30, y + 6);
                    pdf.text('Material Name', 90, y + 6);
                    pdf.text('QR Code', 252, y + 6);

                    y += 13;
                }

                function drawFooter() {
                    const totalPages = pdf.internal.getNumberOfPages();

                    for (let page = 1; page <= totalPages; page++) {
                        pdf.setPage(page);
                        pdf.setFont('helvetica', 'normal');
                        pdf.setFontSize(8);
                        pdf.setTextColor(107, 114, 128);

                        pdf.text(
                            `Page ${page} of ${totalPages}`,
                            pageWidth / 2,
                            pageHeight - 6,
                            { align: 'center' }
                        );
                    }
                }

                drawHeader();

                for (let i = 0; i < items.length; i++) {
                    const item = items[i];

                    if (y + rowHeight > pageHeight - 12) {
                        pdf.addPage();
                        y = 14;
                        drawHeader();
                    }

                    if (i % 2 === 0) {
                        pdf.setFillColor(248, 250, 252);
                        pdf.rect(
                            margin,
                            y - 5,
                            pageWidth - (margin * 2),
                            rowHeight,
                            'F'
                        );
                    }

                    pdf.setFont('helvetica', 'bold');
                    pdf.setFontSize(8.5);
                    pdf.setTextColor(31, 41, 55);

                    pdf.text(
                        String(i + 1),
                        14,
                        y + 5
                    );

                    pdf.setFont('helvetica', 'bold');
                    pdf.setFontSize(9);
                    pdf.setTextColor(37, 99, 235);

                    const codeLines = pdf.splitTextToSize(
                        item.code,
                        50
                    );

                    pdf.text(
                        codeLines.slice(0, 3),
                        30,
                        y + 4
                    );

                    pdf.setFont('helvetica', 'normal');
                    pdf.setFontSize(9);
                    pdf.setTextColor(31, 41, 55);

                    const nameLines = pdf.splitTextToSize(
                        item.name,
                        145
                    );

                    pdf.text(
                        nameLines.slice(0, 4),
                        90,
                        y + 4
                    );

                    /*
                     * සෑම item එකකටම එහිම Material Code එකට
                     * සම්බන්ධ QR Code එක generate කර PDF එකට දමයි.
                     */
                    const qrDataUrl =
                        await createPDFQRCodeDataURL(
                            item.url,
                            160
                        );

                    pdf.addImage(
                        qrDataUrl,
                        'PNG',
                        250,
                        y - 2,
                        qrSize,
                        qrSize
                    );

                    y += rowHeight;
                }

                drawFooter();

                const date =
                    new Date().toISOString().slice(0, 10);

                pdf.save(
                    `Registered-Items-and-QR-Codes-${date}.pdf`
                );

                Swal.close();

                Swal.fire({
                    icon: 'success',
                    title: 'PDF Downloaded',
                    text: 'Material Code, Material Name සහ අදාළ QR Codes PDF එකට ඇතුළත් කර ඇත.',
                    timer: 2200,
                    showConfirmButton: false
                });

            } catch (err) {
                console.error('PDF Export Error:', err);
                Swal.fire(
                    'PDF Error',
                    'PDF එක සෑදීමේදී දෝෂයක් සිදු විය: ' +
                    (err.message || err),
                    'error'
                );
            }
        }

        /* ---------------------------------------------------------
           4-second intro screen
           The logo is copied from the main header so the image is
           stored only once in this single-file application.
           --------------------------------------------------------- */
        (function initIntroScreen() {
            const startTime = performance.now();
            const duration = 4000;
            const overlay = document.getElementById('intro-overlay');
            const bar = document.getElementById('intro-loader-bar');
            const percent = document.getElementById('intro-percent');
            const status = document.getElementById('intro-loader-status');
            const introLogo = document.getElementById('intro-logo');
            const headerLogo = document.querySelector('.app-logo');

            if (headerLogo && introLogo) {
                introLogo.src = headerLogo.src;
            }

            const messages = [
                [0, 'Starting Bin Card workspace...'],
                [28, 'Loading inventory tools...'],
                [52, 'Preparing Excel & stock management...'],
                [76, 'Preparing QR & Bin Card services...'],
                [94, 'Almost ready...'],
                [100, 'Workspace ready']
            ];

            function updateIntro(now) {
                if (!overlay) return;
                const elapsed = now - startTime;
                const progress = Math.min(100, Math.round((elapsed / duration) * 100));

                if (bar) bar.style.width = progress + '%';
                if (percent) percent.textContent = progress + '%';

                let currentMessage = messages[0][1];
                for (const item of messages) {
                    if (progress >= item[0]) currentMessage = item[1];
                }
                if (status) status.textContent = currentMessage;

                if (elapsed < duration) {
                    requestAnimationFrame(updateIntro);
                } else {
                    if (bar) bar.style.width = '100%';
                    if (percent) percent.textContent = '100%';
                    if (status) status.textContent = 'Workspace ready';
                    setTimeout(() => {
                        overlay.classList.add('is-hidden');
                        overlay.setAttribute('aria-hidden', 'true');
                        document.body.classList.remove('splash-active');
                    }, 80);
                }
            }

            requestAnimationFrame(updateIntro);
        })();

        window.addEventListener('DOMContentLoaded', loadItemsFromFirebase);
    </script>
</body>
</html>
